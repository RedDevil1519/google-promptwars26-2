# ──────────────────────────────────────────────────
# Voter Protocol Engine — Environment Variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────────

# Google Civic Information API key
# https://developers.google.com/civic-information/docs/using_api
CIVIC_API_KEY=your_civic_api_key_here

# Google Maps Geocoding API key (used by the India Fallback Engine for country detection)
# Can reuse the same key as CIVIC_API_KEY if it has Maps Geocoding enabled
# https://developers.google.com/maps/documentation/geocoding/get-api-key
GEOCODING_API_KEY=your_geocoding_api_key_here

# Google Maps Embed API key (optional — for polling-location map)
# https://developers.google.com/maps/documentation/embed/get-api-key
MAPS_EMBED_KEY=your_maps_embed_key_here

# Backend server port (default: 4000)
PORT=4000

# Google Cloud Translation API key
TRANSLATION_API_KEY=your_translation_api_key_here

# Google Gemini API key (for the AI "Decrypt Term" explainer feature)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Vite env vars (must be prefixed VITE_ to be exposed to the browser)
VITE_API_BASE_URL=http://localhost:4000
VITE_MAPS_EMBED_KEY=your_maps_embed_key_here
